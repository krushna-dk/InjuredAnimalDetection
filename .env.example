# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=production

# ==========================================
# MYSQL DATABASE CONFIGURATION
# ==========================================
DB_HOST=your-cloud-db-host.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=injured_animal_detection
DB_SSL=true

# ==========================================
# AI VISION SERVICE CONFIGURATION
# ==========================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-flash-lite-latest
AI_CONFIDENCE_THRESHOLD=0.75

# ==========================================
# DUPLICATE REPORT PREVENTION
# ==========================================
DUPLICATE_COOLDOWN_SECONDS=600

# ==========================================
# FILE UPLOADS
# ==========================================
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=uploads

# ==========================================
# EMAIL — HTTPS API (RECOMMENDED for Render)
# ==========================================
# Render Free tier BLOCKS SMTP ports 25/465/587.
# Use one of the HTTPS APIs below instead (port 443, never blocked).
#
# OPTION 1: Resend (https://resend.com) — RECOMMENDED
#   - Free: 3,000 emails/month, 100/day
#   - Sign up -> Dashboard -> API Keys -> Create
#   - Set RESEND_FROM_EMAIL to a verified sender domain
#     OR use "onboarding@resend.dev" for testing (only sends to verified accounts)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
#
# OPTION 2: Brevo (https://brevo.com) — ALTERNATIVE
#   - Free: 300 emails/day
#   - Sign up -> SMTP & API -> API Keys -> Generate
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# SMTP (local development only — blocked on Render Free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="Injured Animal Alert" <your_email@gmail.com>
